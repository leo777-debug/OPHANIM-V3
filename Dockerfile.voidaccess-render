# Test-only VoidAccess API image for Render. The upstream source stays external
# and is pinned so Ophanim deployments remain reproducible.
FROM python:3.11-slim

ARG VOIDACCESS_REF=1953fe56dcd17cb38df768b74f439f2cc2427c2a

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/KatrielMoses/voidaccess.git . && \
    git checkout --detach "$VOIDACCESS_REF" && \
    pip install --no-cache-dir . uvicorn psycopg2-binary asyncpg

COPY scripts/voidaccess-render-start.sh /usr/local/bin/voidaccess-render-start
RUN chmod 755 /usr/local/bin/voidaccess-render-start

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

EXPOSE 10000
CMD ["/usr/local/bin/voidaccess-render-start"]
