# ═══════════════════════════════════════════════════════════════════════════
#  OPHANIM Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  OPHANIM works without third-party API keys for its public feeds. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  Optional integrations read their own server-only environment variables.
#  Set only the credentials for providers you intend to enable. Shodan requires
#  SHODAN_API_KEY; active scans also require AUTHORIZED_SCAN_TARGETS.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND
#  Powers the RECON toolkit (quick/ssl/headers/rdns/subdomains/tech/whois/
#  geoloc/vuln scans). Requires running a compatible scanner backend.
#  SCANNER_KEY here MUST equal the backend's OSIRIS_KEY. Generate one with:
#      openssl rand -hex 32
#  Leave both empty to simply disable the RECON features (UI returns 503).
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=

# Shodan official API (server-only). Leave blank to disable the paid integration.
SHODAN_API_KEY=
# Owned/authorized IPs or CIDRs only. Empty disables active scans.
# For multiple organizations, prefer JSON: {"organization-uuid":["owned-ip/32"]}
AUTHORIZED_SCAN_TARGETS=
SHODAN_CACHE_TTL_MS=60000
SHODAN_TIMEOUT_MS=25000
SHODAN_LOW_CREDITS=10

# All model weights, caches, adapters and exports live on the external disk.
# Override in uncommitted .env if the disk letter changes. Never falls back to C:.
OPHANIM_MODELS_DIR=D:\models
OPHANIM_LOCAL_MODEL=ophanim-logistics:base
OPHANIM_LOCAL_BASE_URL=http://localhost:11434/v1
# Relative manifest path for the model currently served (change for a new version).
OPHANIM_MODEL_FILE=gguf/unsloth--Qwen3-4B-Instruct-2507-GGUF/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# Multilingual Qwen3-Embedding-0.6B (Apache-2.0), 1024 dimensions.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_API_KEY=
KNOWLEDGE_CRON_SECRET=
# Python with ml/requirements.txt installed; OCR also requires Tesseract eng+ara.
KNOWLEDGE_PYTHON=python
KNOWLEDGE_STORAGE_DIR=
# Optional private container extractor; requires the worker secret and allowlisted origin.
KNOWLEDGE_EXTRACTOR_URL=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on 3000).
# Change this if 3000 is already taken on your host.
OPHANIM_PORT=3000

# GhostTrack is installed by the Docker image and invoked only by the backend
# provider for IP, domain (resolved to IP), and username enrichment. Set to
# false to disable it without rebuilding the image.
GHOSTTRACK_ENABLED=true
# GHOSTTRACK_DIR=/opt/ghosttrack
# GHOSTTRACK_PYTHON=/opt/ghosttrack/.venv/bin/python

# Maigret username discovery provider. This runs only on the backend and never
# uses Maigret's optional AI mode. The Docker image sets MAIGRET_COMMAND.
# MAIGRET_ENABLED=true
# MAIGRET_COMMAND=/opt/maigret/.venv/bin/maigret
# MAIGRET_MAX_SITES=100

# VoidAccess dark-web intelligence provider. Run VoidAccess as a separate,
# backend-only service and configure a dedicated Ophanim service account.
# The token is never sent to browsers. Searches run only when the query
# explicitly requests dark-web intelligence, for example "dark web mentions of MSC IRINA".
# VOIDACCESS_API_URL=https://your-voidaccess-service.example
# Configure either a manually issued bearer token or a dedicated service account.
# VOIDACCESS_API_TOKEN=
# VOIDACCESS_API_EMAIL=ophanim-provider@example.com
# VOIDACCESS_API_PASSWORD=

# Safe development-only dark-web fixtures. Keep this false in hosted
# environments: the fixture provider is never enabled when NODE_ENV=production.
# DARK_WEB_FIXTURES_ENABLED=false

# OpenAI-compatible AI provider. These are optional server defaults for
# summarizing, explaining, follow-up search suggestions, and email summaries.
# The AI provider never performs searches or invokes search providers.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_ENABLED_TASKS=summarize,explain,suggest_follow_up_searches,write_email_summary
# Local/private model endpoints must be explicitly allowlisted, for example:
# AI_LOCAL_BASE_URLS=http://host.docker.internal:11434,http://127.0.0.1:1234

# Optional sandbox-only browser research adapter. This URL must point to a
# separately deployed private VM/container; the Ophanim web service never runs
# browser automation itself. The sandbox must return source-attributed results
# from POST /v1/research and must not be publicly exposed.
# AI_SANDBOX_RESEARCH_URL=http://ophanim-research-sandbox:8080
# AI_SANDBOX_RESEARCH_TOKEN=use-a-long-random-value

# Persisted watchlists and Resend email delivery (Render)
# DATABASE_URL=postgresql://...
# APP_URL=https://your-ophanim.onrender.com
# RESEND_API_KEY=re_...
# RESEND_FROM=Ophanim <alerts@your-domain.example>
# RESEND_WEBHOOK_SECRET=whsec_...
# WATCHLIST_CRON_SECRET=use-a-long-random-value
# DISRUPTION_SYNC_CRON_SECRET=use-a-long-random-value
# IMPORT_CRON_SECRET=use-a-long-random-value
# INTELLIGENCE_ALERT_CRON_SECRET=use-a-long-random-value

# Operations login and tenancy. Set a one-time bootstrap token before creating
# the first organization owner, then remove it after setup.
# OPHANIM_BOOTSTRAP_TOKEN=use-a-long-random-value
# OPHANIM_SESSION_DAYS=30
# Published Chrome and Edge extension IDs allowed to call authenticated
# extension endpoints in production, separated by commas.
# OPHANIM_EXTENSION_IDS=chrome-extension-id,edge-extension-id

# Edition capability flags. Start with full, or use core/logistics/cyber/maritime.
# Individual declared features can be added or removed with a comma-separated
# override list, for example `cyber,-dark_web`.
# OPHANIM_EDITION=full
# OPHANIM_FEATURE_FLAGS=

# Comma-separated list of public Telegram channel usernames (no @) to scrape
# for the "Telegram OSINT" map layer. Overrides the curated default set.
# Channels must have web preview enabled (most well-known OSINT channels do).
# Default if unset:
#   osintdefender,insiderpaper,aljazeeraenglish,nexta_live,war_monitor
# OPHANIM_TELEGRAM_CHANNELS=

# Optional self-hosted Umami analytics. When either value is absent, Ophanim
# sends no analytics request.
# UMAMI_ENDPOINT=https://analytics.example.com
# UMAMI_WEBSITE_ID=

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

# Supabase — Postgres, Auth, and private Storage
# Browser-safe values. These are embedded in the frontend bundle; RLS is the
# authorization boundary for requests made with the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server aliases used by route handlers, Proxy, and server-only clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Backend only. Prefer the modern Supabase secret key. The legacy service-role
# key remains supported for older projects. Never prefix either with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-backend-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Use the Supabase transaction-pooler connection string for the existing
# server-side PostgreSQL data layer. Keep this value backend-only.
DATABASE_URL=postgresql://postgres.your-project-ref:password@pooler-host:6543/postgres

# Optional customer-owned intelligence feeds. Results from these endpoints are
# stored only for the requesting organization. Endpoints must return JSON with
# a stable id/external_id/reference and title/name for each record.
# PORT_NOTICE_FEED_URL=https://port-authority.example/api/notices
# OFFICIAL_SANCTIONS_FEED_URL=https://compliance-provider.example/api/updates
# REVIEWED_OSINT_FEED_URL=https://approved-osint.example/api/events
